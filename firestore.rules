rules_version = '2';

// Traction Firestore rules. Deploy from the repo root: firebase deploy --only firestore
//
// The Firebase web config in the website and extension is public by design, so these rules
// are the only thing between the internet and user data. Everything not matched below is
// denied. The Discover collector writes with the Admin SDK, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Firebase Auth UIDs allowed into the admin portal. Keep in sync with VITE_ADMIN_UIDS
    // in Source Code/website/.env.local (that only shows the portal; this enforces it).
    function isAdmin() {
      return signedIn() && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }

    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    // ── Accounts ─────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // New accounts are created by the app on first sign-in (AuthContext).
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'email', 'firstName', 'lastName', 'dob', 'plan', 'status', 'onboardingCompleted'])
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.get('email', '')
                    && request.resource.data.plan in ['Free', 'Pro']
                    && request.resource.data.status == 'Active';
      // Users edit their own name, birthday and onboarding flag; plan and status are admin-only.
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['firstName', 'lastName', 'dob', 'onboardingCompleted']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Applications (web app and Chrome extension) ──────────────────────────

    function validJobStatus(s) {
      // "Wishlist" is the old name for "Saved"; older extension versions still send it.
      return s in ['Saved', 'Applied', 'Interviewing', 'Offer', 'Rejected', 'Wishlist'];
    }
    function jobFields() {
      return ['company', 'title', 'location', 'link', 'dateApplied', 'priority', 'status', 'notes',
              'documents', 'userId', 'createdAt', 'discoveryId', 'fitScore', 'followedUpAt'];
    }

    match /jobs/{jobId} {
      allow read, delete: if owns(resource.data) || isAdmin();
      allow create: if (owns(request.resource.data) || isAdmin())
                    && request.resource.data.keys().hasOnly(jobFields())
                    && validJobStatus(request.resource.data.status);
      allow update: if (owns(resource.data) || isAdmin())
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(jobFields())
                    && validJobStatus(request.resource.data.status);
    }

    match /contacts/{contactId} {
      allow read, delete: if owns(resource.data) || isAdmin();
      allow create: if owns(request.resource.data) || isAdmin();
      allow update: if (owns(resource.data) || isAdmin())
                    && request.resource.data.userId == resource.data.userId;
    }

    // ── Admin portal ─────────────────────────────────────────────────────────

    // Broadcasts: everyone reads the global ones and their own; only admins send.
    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.targetUserId in ['GLOBAL', request.auth.uid]) || isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['message', 'targetUserId', 'type', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /admin_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /vitals/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Discover ─────────────────────────────────────────────────────────────

    // One card per role per user. Users may only triage their own cards.
    match /discoveries/{id} {
      allow read: if owns(resource.data) || isAdmin();
      allow update: if owns(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'jobId', 'statusChangedAt'])
                    && request.resource.data.status in ['new', 'saved', 'dismissed']
                    && (!('jobId' in request.resource.data) || request.resource.data.jobId is string)
                    && request.resource.data.statusChangedAt == request.time;
      allow create, delete: if false;
    }

    // What each user wants Discover to find. Sizes mirror the collector's caps; the
    // collector re-validates every field it reads.
    function validDiscoveryProfile(d) {
      return d.keys().hasOnly(['enabled', 'tracks', 'graduation', 'terms', 'needsSponsorship',
                               'locations', 'roleFamilies', 'includeKeywords', 'excludeKeywords',
                               'companies', 'minScore', 'notify', 'updatedAt'])
        && d.enabled is bool
        && d.tracks is list && d.tracks.size() <= 2 && d.tracks.hasOnly(['intern', 'newgrad'])
        && d.graduation is string && (d.graduation == '' || d.graduation.matches('20[0-9]{2}-(0[1-9]|1[0-2])'))
        && d.terms is map && d.terms.keys().hasOnly(['available', 'partTime'])
        && d.terms.available is list && d.terms.available.size() <= 12
        && d.terms.partTime is list && d.terms.partTime.size() <= 12
        && d.needsSponsorship is bool
        && d.locations is map && d.locations.keys().hasOnly(['preferred', 'remoteOk'])
        && d.locations.preferred is list && d.locations.preferred.size() <= 50
        && d.locations.remoteOk is bool
        && d.roleFamilies is list && d.roleFamilies.size() <= 20
        && d.includeKeywords is list && d.includeKeywords.size() <= 50
        && d.excludeKeywords is list && d.excludeKeywords.size() <= 50
        && d.companies is map && d.companies.keys().hasOnly(['warm', 'target', 'blocked'])
        && d.companies.warm is list && d.companies.warm.size() <= 100
        && d.companies.target is list && d.companies.target.size() <= 100
        && d.companies.blocked is list && d.companies.blocked.size() <= 100
        && d.minScore is int && d.minScore >= 40 && d.minScore <= 90
        && d.notify is map && d.notify.keys().hasOnly(['webhook', 'minScore'])
        && d.notify.webhook is string
        && (d.notify.webhook == ''
            || d.notify.webhook.matches('https://((ptb|canary)[.])?discord(app)?[.]com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+')
            || d.notify.webhook.matches('https://ntfy[.]sh/[A-Za-z0-9_-]{1,64}'))
        && d.notify.minScore is int && d.notify.minScore >= 40 && d.notify.minScore <= 100
        && d.updatedAt == request.time;
    }
    match /discoveryProfiles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && validDiscoveryProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // "Add a careers page": users file a request; the collector validates and answers it.
    match /feedRequests/{id} {
      allow read: if owns(resource.data) || isAdmin();
      allow create: if owns(request.resource.data)
                    && request.resource.data.keys().hasOnly(['userId', 'company', 'url', 'createdAt', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.company is string && request.resource.data.company.size() <= 80
                    && request.resource.data.url is string && request.resource.data.url.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Shared, collector-written. Admins may remove a feed from the admin portal.
    match /companyFeeds/{feedId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if false;
    }
    match /collectorMeta/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Per-user run summaries; `_global` (run health) is admin-only.
    match /collectorRuns/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }
  }
}
