{
  "manifest_version": 3,
  "name": "Offerward",
  "version": "1.1",
  "description": "Save jobs from any careers page into your Offerward pipeline.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "oauth2": {
    "client_id": "27606484237-b8qv20dk4v23aiivh7gdo6q8o7rf71bu.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "*://*.monster.com/*",
    "*://*.ziprecruiter.com/*",
    "*://*.handshake.com/*",
    "*://*.joinhandshake.com/*",
    "*://*.workday.com/*",
    "*://*.greenhouse.io/*",
    "*://boards.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://jobs.lever.co/*",
    "*://*.bamboohr.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.icims.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "*://jobs.ashbyhq.com/*",
    "*://jobs.smartrecruiters.com/*",
    "*://jobs.eu.lever.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Offerward",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.monster.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.handshake.com/*",
        "*://*.joinhandshake.com/*",
        "*://*.workday.com/*",
        "*://*.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://jobs.lever.co/*",
        "*://*.bamboohr.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://jobs.ashbyhq.com/*",
        "*://jobs.smartrecruiters.com/*",
        "*://jobs.eu.lever.co/*"
      ],
      "css": ["css/content.css"],
      "js": ["utils/jobParser.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "config.js",
        "utils/popup/authService.js",
        "utils/popup/firestoreService.js",
        "utils/popup/scrapeService.js"
      ],
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.monster.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.handshake.com/*",
        "*://*.joinhandshake.com/*",
        "*://*.workday.com/*",
        "*://*.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://jobs.lever.co/*",
        "*://*.bamboohr.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://jobs.ashbyhq.com/*",
        "*://jobs.smartrecruiters.com/*",
        "*://jobs.eu.lever.co/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
